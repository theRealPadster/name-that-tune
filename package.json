{
  "name": "name-that-tune",
  "version": "0.4.0",
  "homepage": "https://github.com/theRealPadster/name-that-tune",
  "repository": {
    "type": "git",
    "url": "https://github.com/theRealPadster/name-that-tune.git"
  },
  "bugs": {
    "url": "https://github.com/theRealPadster/name-that-tune/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --out=dist --minify",
    "build:prod": "pnpm run build:local && pnpm run copy:docs",
    "copy:docs": "copyfiles README.md docs/* dist/",
    "lint": "eslint --fix src",
    "lint:ci": "eslint src",
    "type-check": "tsc --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "update-types": "curl -s -o src/types/spicetify.d.ts https://raw.githubusercontent.com/spicetify/cli/main/globals.d.ts"
  },
  "license": "GPL-3.0",
  "engines": {
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm",
    "pnpm": ">=9",
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.65.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "copyfiles": "^2.4.1",
    "dice-coefficient": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.8.0",
    "i18next": "^26.3.0",
    "postcss": "^8.5.26",
    "postcss-modules": "^9.0.1",
    "react-i18next": "^17.0.6",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3"
  }
}
